++#define readx_poll_timeout(op, addr, val, cond, sleep_us, timeout_us) \
++({ \
++	s_time_t deadline = NOW() + MICROSECS(timeout_us); \
++	for (;;) { \
++		(val) = op(addr); \
++		if (cond) \
++			break; \
++		if (NOW() > deadline) { \
++			(val) = op(addr); \
++			break; \
++		} \
++	udelay(sleep_us); \
++	} \
++	(cond) ? 0 : -ETIMEDOUT; \
++})
