++	spin_lock(&xen_domain->lock);
++
++	arm_smmu_detach_dev(dev);
++	atomic_dec(&io_domain->ref);
++
++	if (io_domain->ref.counter == 0)
++		arm_smmu_destroy_iommu_domain(io_domain);
++
++	spin_unlock(&xen_domain->lock);
++
++	return 0;
++}
