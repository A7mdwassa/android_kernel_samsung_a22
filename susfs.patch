-+	struct acpi_iort_smmu_v3 *node_smmu_data;
-+#endif
-+	int ret = 0;
-+
-+	res.type = type;
-+
-+	switch (type) {
-+	case IORESOURCE_MEM:
-+#ifdef CONFIG_ACPI
-+		if (pdev->type == DEV_ACPI) {
-+			ret = 1;
-+			iort_node = pdev->acpi_node;
-+			node_smmu_data =
-+				(struct acpi_iort_smmu_v3 *)iort_node->node_data;
