++static bool is_reset_completed(void *addr)
++{
++    u32 i;
++    for (i = 0; i < 1000; ++i)
++    {
++        u32 val = readl_relaxed(addr);
++        if ( (val & RESET_COMPLETED) )
++        {
++            return true;
++        }
++        udelay(1);
++    }
++
++    return false;
++}
