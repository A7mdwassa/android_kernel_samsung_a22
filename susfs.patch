-#ifdef CONFIG_KDP_NS
-	rkp_set_mnt_root_sb(mnt->mnt, root, root->d_sb);
-	mnt->mnt_mountpoint = mnt->mnt->mnt_root;
-#elif defined(CONFIG_RUSTUH_KDP_NS)
-	kdp_set_mnt_root_sb(mnt->mnt, root, root->d_sb);
-	mnt->mnt_mountpoint = mnt->mnt->mnt_root;
-#else
-	mnt->mnt.mnt_root = root;
-	mnt->mnt.mnt_sb = root->d_sb;
-	mnt->mnt_mountpoint = mnt->mnt.mnt_root;
-#endif
-	mnt->mnt_parent = mnt;
-	lock_mount_hash();
