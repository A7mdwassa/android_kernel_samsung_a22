-static struct mount *clone_mnt(struct mount *old, struct dentry *root,
-					int flag)
-{
-#if defined(CONFIG_KDP_NS) || defined(CONFIG_RUSTUH_KDP_NS)
-	struct super_block *sb = old->mnt->mnt_sb;
-#else
-	struct super_block *sb = old->mnt.mnt_sb;
-#endif
-	struct mount *mnt;
-	int err;
-#if defined(CONFIG_KDP_NS) || defined(CONFIG_RUSTUH_KDP_NS)
-	int nsflags;
-#endif
