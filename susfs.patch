++#define fwnode_call_int_op(fwnode, op, ...)				\
++	(fwnode ? (fwnode_has_op(fwnode, op) ?				\
++		   (fwnode)->ops->op(fwnode, ## __VA_ARGS__) : -ENXIO) : \
++	 -EINVAL)
++#define fwnode_call_bool_op(fwnode, op, ...)				\
++	(fwnode ? (fwnode_has_op(fwnode, op) ?				\
